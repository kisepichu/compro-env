mod libs {
pub mod algebra {
pub mod monoid {
pub trait Monoid {
    type T: Clone;
    fn id() -> Self::T;
    fn op(a: &Self::T, b: &Self::T) -> Self::T;
}

pub struct AddMonoid;

impl Monoid for AddMonoid {
    type T = i64;
    fn id() -> Self::T { 0 }
    fn op(a: &Self::T, b: &Self::T) -> Self::T { a + b }
}

}
}

}
use libs::algebra::monoid::AddMonoid;

fn main() {
    let x = AddMonoid::op(&AddMonoid::id(), &42);
    println!("{x}");
}
