{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "vitest/globals"],
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.mjs", "*.ts"],
  "exclude": [
    "dist",
    "dist-root",
    "dist-compro-env",
    "node_modules",
    "e2e",
    "playwright.config.ts"
  ]
}
