---
/**
 * Search page (`/search/`) — plan 053.
 *
 * The page is composed natively in Astro (rather than via
 * `renderSearchPage` alone) so Astro can bundle the client `<script>`
 * inside `<body>`. The pure `renderSearchPage` remains in
 * `web/src/lib/pages/search.ts` for tests, and this page uses the same
 * shared helpers (`renderHeader`, `renderBreadcrumb`, `renderFooter`,
 * `renderSearchMainInner`) so the shell contract stays identical.
 */
import { resolveUrlConfig } from "@/lib/pages/config.ts";
import {
  formatDocumentTitle,
  homeCrumb,
  renderBreadcrumb,
  renderFooter,
  renderHeader,
} from "@/lib/pages/document.ts";
import { renderSearchMainInner } from "@/lib/pages/search.ts";
import { loadSiteData } from "@/lib/site-data.ts";
import { toAssetUrl, toCanonicalUrl } from "@/lib/url.ts";

const config = resolveUrlConfig();
const siteData = loadSiteData();
const canonical = toCanonicalUrl(config, ["search"]);
const stylesheetHref = toAssetUrl(config, ["assets", "site.css"]);
const documentTitle = formatDocumentTitle(siteData, "Search");
const description = "Search libraries, solutions, and symbols on compro-env.";
const htmlLang = siteData.site.language || "en";

const headerHtml = renderHeader({ config, siteData, currentNav: "search" });
const breadcrumbHtml = renderBreadcrumb([
  homeCrumb(config),
  { label: "Search" },
]);
const footerHtml = renderFooter({ siteData });
const mainInnerHtml = renderSearchMainInner(config);
---
<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href={stylesheetHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteData.site.title} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Fragment set:html={headerHtml} />
    <main id="main-content" data-pagefind-ignore>
      <Fragment set:html={breadcrumbHtml} />
      <Fragment set:html={mainInnerHtml} />
    </main>
    <Fragment set:html={footerHtml} />
    <script>
      import "@/search/client.ts";
    </script>
  </body>
</html>
