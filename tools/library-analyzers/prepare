#!/usr/bin/env bash
# Launcher for `library-adapter-prepare` (spec §6.9, plan 041 Task 2).
#
# Locates the repository root, builds the driver under a locked Cargo
# invocation, and forwards every argument. The driver is the only entry point
# that knows how to acquire the prepare lock, download pinned artifacts, and
# publish the prepared set atomically.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

cd "${repo_root}"
exec cargo run \
  --quiet \
  --locked \
  --package infrastructure \
  --bin library-adapter-prepare \
  -- \
  --repository-root "${repo_root}" \
  "$@"
