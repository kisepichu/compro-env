{
  "name": "compro-env-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for compro-env library and solution browsing.",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "site:build": "astro build --root web",
    "site:preview": "astro preview --root web",
    "site:dev": "astro dev --root web",
    "test": "vitest run --root web",
    "test:watch": "vitest --root web"
  },
  "dependencies": {
    "astro": "7.2.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vitest": "4.1.10"
  }
}
